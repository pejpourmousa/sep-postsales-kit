/* ============================ CSV ============================ */
function parseCSV(text){
  const rows=[]; let row=[], f="", q=false;
  for (let i=0;i<text.length;i++){ const ch=text[i];
    if (q){ if(ch==='"'){ if(text[i+1]==='"'){ f+='"'; i++; } else q=false; } else f+=ch; }
    else if (ch==='"') q=true; else if (ch===','){ row.push(f); f=""; }
    else if (ch==='\n'||ch==='\r'){ if(ch==='\r'&&text[i+1]==='\n') i++; row.push(f); rows.push(row); row=[]; f=""; }
    else f+=ch; }
  if (f!==""||row.length){ row.push(f); rows.push(row); }
  return rows.filter(r=>r.some(c=>c.trim()!==""));
}
const numv = v => { const n=parseFloat(String(v).replace(/[$,\s]/g,"")); return isNaN(n)?null:n; };
function normHealth(v){ const s=String(v||"").trim().toLowerCase(); return s.startsWith("g")?"Green":s.startsWith("y")||s.startsWith("a")?"Yellow":s.startsWith("r")?"Red":""; }
function importCSV(text, label){
  const st=$("#dataStatus"); st.hidden=false;
  try{
    const rows=parseCSV(text); if(rows.length<2) throw new Error("The file needs a header row and at least one account row.");
    const hdr=rows[0].map(h=>h.trim().toLowerCase().replace(/\s+/g,"_"));
    if(!hdr.includes("account_name")) throw new Error("Missing the required account_name column. Copy the template to see the expected headers.");
    const pids=new Set(cfg.products.map(p=>p.id));
    const accounts=rows.slice(1).map((r,ix)=>{ const o={}; hdr.forEach((h,i)=>o[h]=(r[i]??"").trim());
      const a={ id:o.account_id||("ROW-"+(ix+1)), name:o.account_name||("Account "+(ix+1)), owner:o.owner||"Unassigned", segment:o.segment||"Unsegmented",
        health:normHealth(o.health), healthPrev:normHealth(o.health_prev), arr:numv(o.arr)||0, renewal:o.renewal_date||"", contact:numv(o.last_strategic_contact_days), drivers:{}, cur:{}, opps:{} };
      hdr.forEach(h=>{ const v=o[h]; if(RESERVED.includes(h)) return;
        let m;
        if ((m=h.match(/^cur_(.+)$/))) { const n=numv(v); if(n) a.cur[m[1]]=n; }
        else if ((m=h.match(/^opp_(.+)_stage$/))) { if(v){ a.opps[m[1]]=a.opps[m[1]]||{}; a.opps[m[1]].stage=v; } }
        else if ((m=h.match(/^opp_(.+)_amount$/))) { const n=numv(v); if(n!=null){ a.opps[m[1]]=a.opps[m[1]]||{}; a.opps[m[1]].amount=n; } }
        else { const n=numv(v); if(n!=null||v==="") a.drivers[h]=n||0; } });
      Object.keys(a.opps).forEach(k=>{ if(!a.opps[k].stage) delete a.opps[k]; });
      if(!a.arr) a.arr=Object.values(a.cur).reduce((s,v)=>s+v,0);
      return a; });
    const unknownCur=[...new Set(accounts.flatMap(a=>Object.keys(a.cur)))].filter(k=>!pids.has(k));
    data={source:"import", label:label||"Imported data", accounts};
    save("wsn.data", data);
    ui.owner=""; ui.segment=""; ui.product="";
    st.className="status ok"; st.textContent=`Loaded ${accounts.length} accounts.`+(unknownCur.length?` Note: current-ARR columns for ${unknownCur.map(k=>"cur_"+k).join(", ")} don't match a product line — add them in Sizing model with that id.`:"");
    renderFilters(); renderAll();
  }catch(e){ st.className="status err"; st.textContent=e.message; }
}
function toCSV(accounts){
  const drv=allDrivers(), pids=cfg.products.map(p=>p.id);
  const hdr=[...RESERVED,...drv,...pids.map(p=>"cur_"+p),...pids.flatMap(p=>["opp_"+p+"_stage","opp_"+p+"_amount"])];
  const q=v=>{ const s=String(v??""); return /[",\n]/.test(s)?'"'+s.replace(/"/g,'""')+'"':s; };
  const lines=accounts.map(a=>[a.id,a.name,a.owner,a.segment,a.health,a.healthPrev,a.arr,a.renewal,a.contact,...drv.map(d=>a.drivers[d]??""),...pids.map(p=>a.cur[p]??""),...pids.flatMap(p=>[a.opps[p]?.stage??"",a.opps[p]?.amount??""])].map(q).join(","));
  return [hdr.join(","),...lines].join("\n");
}

