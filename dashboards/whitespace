   <div class="dgrid">
     <div><span class="k">Health</span><span>${healthPill(a.health)}${a.healthPrev&&a.healthPrev!==a.health?` <span class="muted" style="font-size:12px">was ${esc(a.healthPrev)}</span>`:""}</span></div>
     <div><span class="k">Account manager</span><span class="v">${esc(a.owner||"–")}</span></div>
     <div><span class="k">Current ARR</span><span class="v num">${money(a.arr)}</span></div>
     <div><span class="k">Renewal</span><span class="v">${fmtDate(a.renewal)} <span class="muted num" style="font-weight:400">${rd==null?"":rd<0?"(lapsed)":`(${rd}d)`}</span></span></div>
     <div><span class="k">Last strategic contact</span><span class="v num">${a.contact==null?"–":a.contact+" days ago"}</span></div>
     <div><span class="k">Priority weight</span><span class="v num">×${row.weight.toFixed(2)}</span></div>
     <div><span class="k">Whitespace ARR</span><span class="v num" style="color:var(--accent-ink);font-size:18px">${money(ws)}</span></div>
     <div><span class="k">Penetration</span><span class="v num">${pct(pot?1-ws/pot:0)} of sized potential</span></div>
   </div>
   <div class="playbox ${esc(a.health)}"><strong>Suggested play:</strong> ${best?esc(playFor(row,best))+(a.health!=="Red"?` — lead with <strong>${esc(best.name)}</strong> (${money(row.cells[best.id].ws)}).`:"."):"Fully penetrated on every sized product line — focus on retention and advocacy."}</div>
   <div><h3 style="font-size:13px;margin-bottom:6px">Sizing by product line</h3>
   <table class="dtable"><thead><tr><th>Product</th><th class="r">Potential</th><th class="r">Current</th><th class="r">Whitespace</th></tr></thead><tbody>`+
   prods.filter(p=>row.cells[p.id].potential>0||row.cells[p.id].cur>0).map(p=>{ const c=row.cells[p.id];
     return `<tr><td><strong style="font-size:12.5px">${esc(p.name)}</strong>${c.opp?` <span class="tag opp">${esc(c.opp.stage)} · ${money(c.opp.amount)}</span>`:""}<div class="basis">${p.type==="pct"?money(c.qty):fmtN(c.qty)} ${esc(driverLabel(p.driver))} × ${priceText(p)}</div></td><td class="r num">${money(c.potential)}</td><td class="r num ink2">${c.cur?money(c.cur):"–"}</td><td class="r num"><strong>${c.ws?money(c.ws):c.cur?"✓":"–"}</strong></td></tr>`; }).join("")+
   `</tbody></table>${(()=>{ const na=prods.filter(p=>!(row.cells[p.id].potential>0||row.cells[p.id].cur>0)); return na.length?`<p class="muted" style="font-size:12px;margin-top:6px">Not applicable (driver is 0): ${na.map(p=>esc(p.name)).join(", ")}</p>`:""; })()}</div>
   <div><h3 style="font-size:13px;margin-bottom:6px">Sizing drivers on file</h3><div class="dgrid">${Object.entries(a.drivers).map(([k,v])=>`<div><span class="k">${esc(driverLabel(k))}</span><span class="v num">${/arr/i.test(k)?money(v):fmtN(v)}</span></div>`).join("")}</div></div>`;
  d.hidden=false; $("#scrim").hidden=false; $("#dClose").onclick=closeDrawer; $("#dClose").focus();
}
